#include <stdio.h>

typedef struct {
    char nome[50];
    int idade;
    float salario;
} Funcionario;

int main(void) {
    Funcionario funcionario1, funcionario2;

    printf("===== CADASTRO DE FUNCIONARIOS =====\n");

    printf("\n--- Funcionario 1 ---\n");
    printf("Nome: ");
    fgets(funcionario1.nome, sizeof(funcionario1.nome), stdin);
    printf("Idade: ");
    scanf("%d", &funcionario1.idade);
    printf("Salario: ");
    scanf("%f", &funcionario1.salario);
    getchar();  // consome o '\n' que ficou no buffer antes do próximo fgets

    printf("\n--- Funcionario 2 ---\n");
    printf("Nome: ");
    fgets(funcionario2.nome, sizeof(funcionario2.nome), stdin);
    printf("Idade: ");
    scanf("%d", &funcionario2.idade);
    printf("Salario: ");
    scanf("%f", &funcionario2.salario);

    printf("\n===== DADOS CADASTRADOS =====\n");

    printf("\nFuncionario 1\n");
    printf("Nome: %s", funcionario1.nome);
    printf("Idade: %d\n", funcionario1.idade);
    printf("Salario: R$ %.2f\n", funcionario1.salario);

    printf("\nFuncionario 2\n");
    printf("Nome: %s", funcionario2.nome);
    printf("Idade: %d\n", funcionario2.idade);
    printf("Salario: R$ %.2f\n", funcionario2.salario);

    printf("\n===== RESULTADO =====\n");

    if (funcionario1.salario > funcionario2.salario) {
        printf("Maior salario: %s", funcionario1.nome);
        printf("Diferenca salarial: R$ %.2f\n",
               funcionario1.salario - funcionario2.salario);
    } else if (funcionario2.salario > funcionario1.salario) {
        printf("Maior salario: %s", funcionario2.nome);
        printf("Diferenca salarial: R$ %.2f\n",
               funcionario2.salario - funcionario1.salario);
    } else {
        printf("Os dois funcionarios recebem o mesmo salario.\n");
    }

    return 0;
}
