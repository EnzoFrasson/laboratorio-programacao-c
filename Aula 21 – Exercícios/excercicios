#include <stdio.h>

int main(void) {
    FILE *arquivo;
    char nome[50];
    int matricula;
    int quantidade;

    printf("Quantos funcionarios deseja cadastrar (1 a 5)? ");
    scanf("%d", &quantidade);

    if (quantidade < 1 || quantidade > 5) {
        printf("Quantidade invalida! Informe um valor entre 1 e 5.\n");
        return 1;
    }

    arquivo = fopen("funcionarios.txt", "a");
    if (arquivo == NULL) {
        perror("Erro ao abrir arquivo");
        return 1;
    }

    for (int i = 0; i < quantidade; i++) {
        printf("\n--- Funcionario %d ---\n", i + 1);

        printf("Nome: ");
        scanf(" %49[^\n]", nome);

        printf("Matricula: ");
        scanf("%d", &matricula);

        fprintf(arquivo, "Nome: %s | Matricula: %d\n", nome, matricula);
    }

    if (fclose(arquivo) != 0) {
        perror("Erro ao salvar os dados");
        return 1;
    }

    printf("\nDados gravados com sucesso em funcionarios.txt!\n");

    return 0;
}



















#include <stdio.h>

int main(void) {
    FILE *arquivo;
    int numero;

    // Gravação
    arquivo = fopen("numeros.txt", "w");
    if (arquivo == NULL) {
        perror("Erro ao abrir arquivo para escrita");
        return 1;
    }

    for (int i = 0; i < 5; i++) {
        printf("Digite o numero %d: ", i + 1);
        scanf("%d", &numero);
        fprintf(arquivo, "%d\n", numero);   // um número por linha
    }

    fclose(arquivo);
    printf("\nNumeros gravados com sucesso em numeros.txt!\n");

    // Leitura
    arquivo = fopen("numeros.txt", "r");
    if (arquivo == NULL) {
        perror("Erro ao abrir arquivo para leitura");
        return 1;
    }

    printf("\n===== NUMEROS ARMAZENADOS =====\n");
    while (fscanf(arquivo, "%d", &numero) == 1) {
        printf("%d\n", numero);
    }

    fclose(arquivo);

    return 0;
}



















#include <stdio.h>

typedef struct {
    char nome[50];
    float salario;
    int horasExtras;
} Funcionario;

int main(void) {
    FILE *arquivo;
    Funcionario f;
    int opcao;
    int quantidade;
    int caractere;

    do {
        printf("\n===== CADASTRO DE FUNCIONARIOS =====\n");
        printf("1 - Cadastrar funcionarios\n");
        printf("2 - Visualizar funcionarios\n");
        printf("0 - Sair\n");
        printf("Escolha uma opcao: ");

        if (scanf("%d", &opcao) != 1) {
            printf("Opcao invalida!\n");
            return 1;
        }

        if (opcao == 1) {
            printf("\nQuantos funcionarios deseja cadastrar (1 a 5)? ");
            scanf("%d", &quantidade);

            if (quantidade < 1 || quantidade > 5) {
                printf("Quantidade invalida! Informe um valor entre 1 e 5.\n");
                continue;
            }

            // modo "a": acrescenta sem apagar os registros anteriores
            arquivo = fopen("funcionarios.txt", "a");
            if (arquivo == NULL) {
                perror("Erro ao abrir arquivo");
                continue;
            }

            for (int i = 0; i < quantidade; i++) {
                printf("\n--- Funcionario %d ---\n", i + 1);

                printf("Nome: ");
                scanf(" %49[^\n]", f.nome);

                printf("Salario: ");
                scanf("%f", &f.salario);

                printf("Horas extras: ");
                scanf("%d", &f.horasExtras);

                fprintf(arquivo, "Nome: %s\n", f.nome);
                fprintf(arquivo, "Salario: R$ %.2f\n", f.salario);
                fprintf(arquivo, "Horas extras: %d\n", f.horasExtras);
                fprintf(arquivo, "----------------------------------------\n");
            }

            if (fclose(arquivo) != 0) {
                perror("Erro ao salvar os dados");
            } else {
                printf("\nDados gravados com sucesso em funcionarios.txt!\n");
            }
        }
        else if (opcao == 2) {
            arquivo = fopen("funcionarios.txt", "r");
            if (arquivo == NULL) {
                printf("\nNenhum funcionario cadastrado.\n");
                continue;
            }

            printf("\n===== FUNCIONARIOS CADASTRADOS =====\n\n");
            while ((caractere = fgetc(arquivo)) != EOF) {
                putchar(caractere);
            }

            fclose(arquivo);
        }
        else if (opcao == 0) {
            printf("\nPrograma encerrado.\n");
        }
        else {
            printf("\nOpcao invalida!\n");
        }
    } while (opcao != 0);

    return 0;
}
